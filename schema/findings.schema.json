{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PCone sitewatch finding",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "id",
    "rule_id",
    "severity",
    "url",
    "evidence",
    "found_at",
    "recurrence",
    "repeat",
    "shared_file",
    "allowlist",
    "action"
  ],
  "properties": {
    "id": {"type": "string"},
    "rule_id": {"type": "string"},
    "severity": {"type": "string", "enum": ["critical", "high", "medium", "low", "info"]},
    "url": {"type": "string"},
    "evidence": {"type": "string"},
    "found_at": {"type": "string"},
    "recurrence": {"type": "integer", "minimum": 0},
    "repeat": {"type": "boolean"},
    "shared_file": {"type": ["string", "null"]},
    "allowlist": {"type": "boolean"},
    "action": {"type": "string", "enum": ["report_only", "safe_auto", "skipped"]}
  }
}
